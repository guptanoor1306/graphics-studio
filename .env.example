ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: Whisper transcription for episode audio upload (storyboard timing)
OPENAI_API_KEY=sk-...
STUDIO_MODEL=claude-opus-5-5
STUDIO_URL=http://127.0.0.1:8000
# DATABASE_URL=postgresql://...   # Render Postgres; omit locally to use data/studio.db
# Render review after generation: frames are rendered, checked and sent back to Claude to fix (0 = off)
STUDIO_CRITIQUE_ROUNDS=2
# Adaptive thinking on storyboard + fix calls (off to disable); optional effort: low|medium|high|xhigh|max
STUDIO_THINKING=adaptive
# STUDIO_EFFORT=high
# STUDIO_SB_MAX_TOKENS=48000
# Old keyword presets that bolt a building + person onto frames (1 = on)
STUDIO_ENRICH_PRESETS=0
# Images for "ASSET NEEDED" placeholders: Gemini if a key is set, otherwise Claude draws a flat SVG (0 = off)
# GEMINI_API_KEY=...
# STUDIO_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview   # falls back to gemini-2.5-flash-image
STUDIO_ASSET_GEN=1
# Claude checks each generated image against the kit illustrations and asks Gemini for one retry (0 = off)
STUDIO_ASSET_QA=1
